using Gtk 4.0;

template $PerformancePageCpu : Box {
  margin-bottom: 10;

  orientation: vertical;

  Grid {
    row-spacing: 10;

    Box top {
      orientation: vertical;
      layout {
        column: '0';
        row: '0';
        row-span: 7;
      }

      WindowHandle {
        child: Box description {
          orientation: vertical;
          margin-top: 2;
          spacing: 7;
          hexpand: true;

          Box {
            spacing: 20;

            Label {
              styles [
                "title-1",
              ]

              hexpand: true;
              halign: start;
              label: _("CPU");
            }

            Label cpu_name {
              styles [
                "title-3",
              ]

              halign: end;
              ellipsize: middle;
              selectable: true;
            }
          }
          Box {
            Label {
              styles [
                "caption",
              ]

              label: _("Utilization over ");
            }
            Label graph_max_duration {
              styles [
                "caption",
              ]

              hexpand: true;
              halign: start;
            }
            Label {
              styles [
                "caption",
              ]

              label: _("100%");
            }
          }
        };
      }

      Grid usage_graphs {
        row-spacing: 7;
        column-spacing: 7;
        vexpand: true;
        hexpand: true;

        height-request: 20;
        width-request: 100;

        row-homogeneous: true;
        column-homogeneous: true;
      }
    }
    Box bottom_graph_box {
      layout {
        column: '0';
        row: '7';
        row-span: 3;
      }

      Box {
        orientation: vertical;

        Box {
          Label bottom_graph_label {
            styles [
              "caption",
            ]

            ellipsize: middle;
          }
          Label {
            styles [
              "caption",
            ]

            hexpand: true;
            halign: start;
            label: bind graph_max_duration.label;
          }

          Label bottom_graph_total {
            styles [
              "caption",
            ]
          }
        }

        $McGraphWidget bottom_graph {
          vexpand: true;
          hexpand: true;

          width-request: 50;
          height-request: 30;

          base-color: bind template.base-color;
          scroll: true;
        }
      }
    }
  }

  PopoverMenu context_menu {
    has-arrow: false;
    menu-model: context_menu_model;
  }
}

menu context_menu_model {
  section {
    submenu {
      label: _("Change _Top Graph To");

      item {
        label: _("Overall U_tilization");
        action: "graph.overall";
      }

      item {
        label: _("Logical _Processors");
        action: "graph.all-processors";
      }

      item {
        label: _("_All Threads");
        action: "graph.all-threads";
      }

      item {
        label: _("All Threads _Stacked");
        action: "graph.all-threads-stacked";
      }
    }

    submenu {
      label: _("Change B_ottom Graph To");

      item {
        label: _("_Power Draw");
        action: "graph.cpu_power";
      }

      item {
        label: _("_Temperature");
        action: "graph.cpu_temperature";
      }

      item {
        label: _("_Clock Speed");
        action: "graph.cpu_clocks";
      }

      item {
        label: _("_None");
        action: "graph.cpu_none";
      }
    }

    item {
      label: _("Show Kernel Times");
      action: "graph.kernel_times";
    }
  }

  section {
    item {
      label: _("Graph _Summary View");
      action: "graph.summary";
    }

    submenu {
      label: _("_View");

      item {
        label: _("CP_U");
        action: "graph.cpu";
      }

      item {
        label: _("_Memory");
        action: "graph.memory";
      }

      item {
        label: _("_Drive");
        action: "graph.disk";
      }

      item {
        label: _("_Network");
        action: "graph.network";
      }

      item {
        label: _("_GPU");
        action: "graph.gpu";
      }

      item {
        label: _("_Fan");
        action: "graph.fan";
      }

      item {
        label: _("_Battery");
        action: "graph.battery";
      }
    }
  }

  section {
    item {
      label: _("_Copy");
      action: "graph.copy";
    }
  }
}
