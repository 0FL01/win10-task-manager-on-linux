msgid "Used (incl. cache)"
msgstr "Занято (вкл. кеш)"

msgid "Mixed modules"
msgstr "Разные модули"

msgid "Installed: {}\nOS-managed RAM: {}\nOutside OS-managed RAM: {}\n\nThe difference includes firmware reservations and early kernel allocations."
msgstr "Установлено: {}\nОбъём для ОС: {}\nВне управления ОС: {}\n\nРазница включает резервирование прошивки и ранние выделения памяти ядром."

msgid "OS-managed RAM: {}\n\nInstalled capacity is unknown because the memory slot inventory is incomplete."
msgstr "Объём для ОС: {}\n\nУстановленный объём неизвестен: сведения о слотах памяти неполны."

msgid "Of used: cache"
msgstr "Из занятого: кеш"

msgid "Physical memory composition"
msgstr "Физический состав памяти"

msgid "RAM occupied (including cache) over "
msgstr "Занято RAM, включая кеш, за "

msgid "Available (estimate):"
msgstr "Доступно (оценка):"

msgid "Installed:"
msgstr "Установлено:"

msgid "Outside OS-managed RAM:"
msgstr "Вне управляемой ОС памяти:"

msgid "OS-managed RAM:"
msgstr "Управляется ОС:"

msgid "{} installed · {} OS"
msgstr "{} установлено · {} для ОС"

msgid "Occupied RAM, including cache ({})\n\nTotal minus MemFree. Includes programs, kernel, drivers, shared memory, buffers and cache. Cache is part of this value, not an additional allocation. MemAvailable is a separate estimate of reusable memory."
msgstr "Занято RAM, включая кеш ({})\n\nВсего минус MemFree. Включает программы, ядро, драйверы, общую память, буферы и кеш. Кеш уже входит в это число. MemAvailable — отдельная оценка памяти, которую можно предоставить новым задачам."

msgid "Other: {}\nCache: {}\nShared: {}\nBuff: {}\nFree: {}"
msgstr "Прочее: {}\nКеш: {}\nОбщая: {}\nБуферы: {}\nСвободно: {}"

msgid "Other ({})\n\nPrograms, kernel and other memory outside Cache, Shared and Buff. All four non-free sections together equal Used (incl. cache). MemAvailable is a separate estimate, not a section of this bar."
msgstr "Прочее ({})\n\nПрограммы, ядро и другая память за исключением Кеша, Общей памяти и Буферов. Все четыре несвободных раздела вместе равны «Занято (вкл. кеш)». MemAvailable — отдельная оценка, а не раздел этой полосы."

msgid "Free ({})\n\nUnoccupied physical memory (MemFree). Cache, including ZFS ARC, is not free memory."
msgstr "Свободно ({})\n\nНезанятая физическая память (MemFree). Кеш, включая ZFS ARC, не является свободной памятью."

