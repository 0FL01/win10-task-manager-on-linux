#: data/io.missioncenter.MissionCenter.gschema.xml:238
msgid "Show virtual network devices (Docker, Multipass, Bridge) by default"
msgstr ""
"Ve výchozím stavu rovnou zobrazovat virtuální síťová zařízení (Docker, "
"Multipass, síťový most)"

#: data/io.missioncenter.MissionCenter.gschema.xml:243
msgid "Show other network devices (Bluetooth, InfiniBand, WWAN) by default"
msgstr ""
