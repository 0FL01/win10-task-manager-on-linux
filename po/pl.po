msgstr "Domyślnie wyświetlaj urządzenia sieciowe VPN"

#: data/io.missioncenter.MissionCenter.gschema.xml:238
msgid "Show virtual network devices (Docker, Multipass, Bridge) by default"
msgstr ""
"Domyślnie wyświetlaj wirtualne urządzenia sieciowe (Docker, Multipass, "
