                      "url": "https://www.samba.org/ftp/talloc/talloc-2.4.1.tar.gz",
                      "sha256": "410a547f08557007be0e88194f218868358edc0ab98c98ba8c167930db3d33f9"
                    }
                  ],
                  "cleanup": [
                    "*"
                  ]
                }
              ],
              "cleanup": [
                "*"
              ]
            }
          ]
        }
      ],
      "build-commands": [
        "cargo --offline build --release -p taskmanager-app",
        "install -Dm755 target/release/taskmanager /app/bin/taskmanager",
        "strip /app/bin/taskmanager",
        "cargo --offline run --release -p xtask -- install --data-only --prefix /app"
      ]
    }
  ]
