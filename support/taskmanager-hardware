import xml.etree.ElementTree as ET

GRANTS = "/var/lib/taskmanager-hardware"
SOCKET = "/run/taskmanager-hardware.sock"
SESSION_DIRECTORY = "/run"
INSTALL_ROOT = "/"
OWNER_UID = 0
LOCAL_HELPER = "/usr/local/libexec/taskmanager-hardware"
LOCAL_UNITS = "/usr/local/lib/systemd/system"
POLICY = "/usr/share/polkit-1/actions/io.github.taskmanager.hardware.policy"
COMMAND_TIMEOUT = 15
LOCK_TIMEOUT = 45
REPLY_LIMIT = 131072


class Busy(RuntimeError):
    pass


def rooted(path):
    # A module constant overridden only by disposable-root tests, never caller input.
    return Path(INSTALL_ROOT) / path.lstrip("/")


def secure_directory(path, create=False):
    path = Path(path)
    if path == Path(INSTALL_ROOT) or path == path.parent:
        info = path.lstat()
    else:
        secure_directory(path.parent, create)
        if create:
            try:
                path.mkdir(mode=0o700 if path == Path(GRANTS) else 0o755)
            except FileExistsError:
                pass
        info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != OWNER_UID or info.st_mode & 0o022:
        raise RuntimeError(f"Untrusted directory: {path}")


def secure_regular(path):
    info = Path(path).lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != OWNER_UID or info.st_mode & 0o022 or info.st_nlink != 1:
        raise RuntimeError(f"Untrusted file: {path}")
    return info


@contextmanager
def operation_lock(lifetime=None, wait=True):
    secure_directory(GRANTS, create=True)
    fd = os.open(f"{GRANTS}/.operation.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != OWNER_UID or info.st_mode & 0o077 or info.st_nlink != 1:
            raise RuntimeError("Untrusted hardware operation lock")
        deadline = time.monotonic() + LOCK_TIMEOUT
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if not wait or time.monotonic() >= deadline:
                    raise Busy("A hardware grant operation is still running.")
                if lifetime is not None:
                    lifetime.check()
                time.sleep(0.05)
        # A cancelled installer waiting behind revoke cannot issue a later grant.
        if lifetime is not None:
            lifetime.check()
        yield
    finally:
        os.close(fd)


class Lifetime:
    def __init__(self, pid, uid, fd=0):
        self.fd = fd
        self.deadline = time.monotonic() + 75
        self.parent = os.pidfd_open(pid)
        try:
            if Path(f"/proc/{pid}").stat().st_uid != uid or not stat.S_ISFIFO(os.fstat(fd).st_mode):
                raise RuntimeError("The requesting application's identity or lifetime pipe is invalid")
            self.check()
        except BaseException:
            self.close()
            raise

    def check(self):
        ready, _, _ = select.select([self.parent, self.fd], [], [], 0)
        if time.monotonic() >= self.deadline or self.parent in ready or (self.fd in ready and not os.read(self.fd, 1)):
            raise RuntimeError("The hardware request was cancelled or the application closed")

    def close(self):
        os.close(self.parent)


def run_fixed(arguments, lifetime=None):
    # This root child owns and reaps its system tools; the unprivileged GUI cannot do so.
    child = subprocess.Popen(arguments, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    deadline = time.monotonic() + COMMAND_TIMEOUT
    output = bytearray()
    try:
        while True:
            if lifetime is not None:
                lifetime.check()
            if time.monotonic() >= deadline:
                raise RuntimeError("The hardware system command timed out")
            ready, _, _ = select.select([child.stdout], [], [], 0.05)
            if ready:
                chunk = os.read(child.stdout.fileno(), 4096)
                output.extend(chunk)
                if len(output) > 65536:
                    raise RuntimeError("The hardware system command returned too much data")
                if not chunk and child.poll() is not None:
                    break
        if child.returncode != 0:
            raise RuntimeError("The hardware system command failed")
        return output.decode("utf-8")
    finally:
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=1)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait(timeout=1)
        child.stdout.close()


def encoded_reply(result):
    data = json.dumps(result, allow_nan=False).encode() + b"\n"
    if len(data) > REPLY_LIMIT:
        raise RuntimeError("Hardware reply exceeds its fixed limit")
    return data


def read(path):
    try:
        with open(path, encoding="utf-8") as stream:
            return stream.read(4096).strip()
    except (OSError, UnicodeError):
        return None


def voltage(labels):
    values = []
    for path in glob.glob("/sys/class/hwmon/hwmon*/in*_label"):
        label = read(path)
        if label and label.casefold() in labels:
            try:
                value = float(read(path[:-6] + "_input"))
                if 0 < value <= 5000:
                    values.append(value / 1000)
            except (TypeError, ValueError):
                pass
    return values[0] if len(values) == 1 else None


def intel_multiplier():
    # IA32_PERF_STATUS[15:8]: current ratio on these documented family-6 models.
    # Hybrid CPUs and unknown generations are deliberately excluded.
    info = (read("/proc/cpuinfo") or "").split("\n\n", 1)[0]
    fields = dict(line.split(":", 1) for line in info.splitlines() if ":" in line)
    fields = {key.strip(): value.strip() for key, value in fields.items()}
    if fields.get("vendor_id") != "GenuineIntel" or fields.get("cpu family") != "6":
        return None
    if "hypervisor" in fields.get("flags", "").split():
        return None
    if fields.get("model") not in {"42", "45", "58", "62", "60", "63", "69", "70", "61", "71", "79", "86", "78", "94", "142", "158", "165", "166"}:
        return None
    for path in sorted(glob.glob("/dev/cpu/[0-9]*/msr")):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
            try:
                value = struct.unpack("<Q", os.pread(fd, 8, 0x198))[0]
            finally:
                os.close(fd)
            ratio = (value >> 8) & 255
            return ratio if ratio else None
        except (OSError, struct.error):
            continue
    return None


def cpu_identity():
    # All adapters reject virtual CPUs and unknown models before privileged reads.
    info = (read("/proc/cpuinfo") or "").split("\n\n", 1)[0]
    fields = {k.strip(): v.strip() for k, v in (line.split(":", 1) for line in info.splitlines() if ":" in line)}
    if "hypervisor" in fields.get("flags", "").split():
        return None
    try:
        return fields.get("vendor_id"), int(fields["cpu family"]), int(fields["model"])
    except (KeyError, ValueError):
        return None


def binary(path, size):
    try:
        with open(path, "rb") as stream:
            data = stream.read(size + 1)
        return data if len(data) == size else None
    except OSError:
        return None


def amd_multiplier(identity):
    # Family 17h/Zen 3 HW_PSTATE_STATUS: programmed FID/DFSID, not effective clock.
    supported = {(0x17, model) for model in (0x01, 0x08, 0x11, 0x18, 0x20, 0x31, 0x60, 0x68, 0x71, 0x90)}
    supported |= {(0x19, model) for model in (0x01, 0x08, 0x21, 0x50)}
    if not identity or identity[0] != "AuthenticAMD" or identity[1:] not in supported:
        return {}
    for path in sorted(glob.glob("/dev/cpu/[0-9]*/msr")):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
            try:
                value = struct.unpack("<Q", os.pread(fd, 8, 0xC0010293))[0]
            finally:
                os.close(fd)
            fid, dfsid = value & 255, (value >> 8) & 63
            if fid and dfsid and 1 <= 2 * fid / dfsid <= 100:
                return {"cpu_multiplier": 2 * fid / dfsid, "multiplier_source": f"HW_PSTATE_STATUS · CPU {Path(path).parent.name} · programmed ratio"}
        except (OSError, struct.error):
            continue
    return {}


def ryzen_pm(identity):
    # Known version+codename+CPU+exact size. No guessed layouts or SMU writes.
    layouts = {
        (4, 0x240803): (0x17, 0x71, 0x7E4, (48, 50, 51), 41),
        (4, 0x240903): (0x17, 0x71, 0x518, (48, 50, 51), 40),
        (12, 0x380804): (0x19, 0x21, 0x8A4, (48, 50, 51), 41),
        (12, 0x380805): (0x19, 0x21, 0x8F0, (48, 50, 51), 40),
        (12, 0x380904): (0x19, 0x21, 0x5A4, (48, 50, 51), 41),
        (14, 0x400005): (0x19, 0x50, 0x944, (409, 410, 411), 99),
    }
    if not identity or identity[0] != "AuthenticAMD" or identity[1:] not in {(0x17, 0x71), (0x19, 0x21), (0x19, 0x50)}:
        return {}
    root = "/sys/kernel/ryzen_smu_drv"
    try:
        codename = int(read(root + "/codename"))
        version = struct.unpack("<I", binary(root + "/pm_table_version", 4))[0]
        family, model, size, indices, voltage_index = layouts[(codename, version)]
        if identity[1:] != (family, model) or struct.unpack("<Q", binary(root + "/pm_table_size", 8))[0] != size:
            return {}
        data = binary(root + "/pm_table", size)
        if data is None:
            return {}
        clocks = [struct.unpack_from("<f", data, index * 4)[0] for index in indices]
        if any(not math.isfinite(v) or not 100 <= v <= 10000 for v in clocks):
            return {}
        result = dict(zip(("fclk_mhz", "uclk_mhz", "mclk_mhz"), clocks))
        result["clock_source"] = f"ryzen_smu PM table 0x{version:06x} (version-specific)"
        voltage = struct.unpack_from("<f", data, voltage_index * 4)[0]
        if math.isfinite(voltage) and 0.1 <= voltage <= 2:
            result["cpu_voltage_v"] = voltage
            result["voltage_source"] = f"ryzen_smu PM table 0x{version:06x} · CPU telemetry voltage"
        return result
    except (OSError, TypeError, ValueError, KeyError, struct.error):
        return {}


def amd_hsmp(identity):
    # Linux HSMP read-only GET_FCLK_MCLK. Multi-socket aggregation is not guessed.
    if not identity or identity[0] != "AuthenticAMD":
        return {}
    packages = {read(p) for p in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/topology/physical_package_id")}
    if packages != {"0"}:
        return {}
    try:
        fd = os.open("/dev/hsmp", os.O_RDONLY | os.O_CLOEXEC)
        try:
            message = bytearray(struct.pack("<IHH8IH2x", 0x0F, 0, 2, *([0] * 8), 0))
            fcntl.ioctl(fd, 0xC02CF800, message, True)
        finally:
            os.close(fd)
        fclk, mclk = struct.unpack_from("<II", message, 8)
        if 100 <= fclk <= 10000 and 100 <= mclk <= 10000:
            return {"fclk_mhz": fclk, "mclk_mhz": mclk, "clock_source": "Linux HSMP GET_FCLK_MCLK"}
    except (OSError, ValueError, struct.error):
        pass
    return {}


def intel_memory(identity):
    # Fixed MCHBAR reads only. Base comes from the allowlisted CPU's host bridge, never a client.
    if not identity or identity[0:2] != ("GenuineIntel", 6):
        return {}
    model = identity[2]
    if model not in {0x8C, 0x8D, 0xA7, 0x97, 0x9A, 0xB7, 0xBA, 0xC6}:
        return {}
    root = "/sys/bus/pci/devices/0000:00:00.0"
    if read(root + "/vendor") != "0x8086" or read(root + "/class") != "0x060000":
        return {}
    try:
        config = os.open(root + "/config", os.O_RDONLY | os.O_CLOEXEC)
        try:
            register = struct.unpack("<Q", os.pread(config, 8, 0x48))[0]
        finally:
            os.close(config)
        if not register & 1:
            return {}
        top = 38 if model in {0x8C, 0x8D} else 41
        alignment = 15 if model == 0xA7 else 17
        base = register & (((1 << (top + 1)) - 1) & ~((1 << alignment) - 1))
        if not base:
            return {}
        fd = os.open("/dev/mem", os.O_RDONLY | os.O_CLOEXEC)
        try:
            def word(offset):
                value = struct.unpack("<I", os.pread(fd, 4, base + offset))[0]
                if value == 0xFFFFFFFF:
                    raise ValueError("Unavailable MCHBAR")
                return value
            if model == 0xC6:
                khz = word(0x5F60)
                if 40000 <= khz <= 500000:
                    return {"bclk_mhz": khz / 1000, "bclk_source": "MCHBAR BCLK_FREQ · firmware-reported SoC clock"}
                return {}
            older = model in {0x8C, 0x8D, 0xA7}
            gears = []
            for controller in range(1 if model == 0xA7 else 2):
                offset = controller * 0x10000
                memory_type = word(offset + (0x5000 if older else 0xD800)) & 7
                for channel in range(2):
                    dimm = word(offset + (0x500C if older else 0xD80C) + channel * 4)
                    if dimm & 0x7F == 0 and (dimm >> 16) & 0x7F == 0:
                        continue
                    if memory_type not in ({0} if older else {0, 1}):
                        return {}  # LPDDR scheduler semantics differ.
                    cfg = word(offset + (0x4088 + channel * 0x400 if older else 0xE088 + channel * 0x800))
                    if not older and cfg & (1 << 15) and cfg & (1 << 31):
                        return {}  # Conflicting mode bits are not a trustworthy gear.
                    if not older and cfg & (1 << 15):
                        gear = 4
                    else:
                        gear = 2 if cfg & (1 << 31) else 1
                    if not older and memory_type == 1 and gear == 1:
                        return {}
                    gears.append(gear)
            if gears and len(set(gears)) == 1:
                return {"intel_gear": gears[0], "gear_source": "MCHBAR SC_GS_CFG · active DDR channels"}
        finally:
            os.close(fd)
    except (OSError, ValueError, struct.error):
        pass
    return {}


def clock(labels):
    values = []
    for path in glob.glob("/sys/class/hwmon/hwmon*/freq*_label"):
        label = read(path)
        if label and label.casefold() in labels:
            try:
                value = float(read(path[:-6] + "_input"))
                if 0 < value < 20_000_000_000:
                    values.append(value / 1_000_000)
            except (TypeError, ValueError):
                pass
    return values[0] if len(values) == 1 else None


def snapshot():
    result = {
        "cpu_voltage_v": voltage({"vcore", "cpu vcore", "svi2_core", "cpu core voltage"}),
        "ram_voltage_v": voltage({"dram", "vdimm", "vddram", "ddr", "dram voltage"}),
        "cpu_multiplier": intel_multiplier(),
        "bclk_mhz": clock({"bclk", "bus clock"}),
        "fclk_mhz": clock({"fclk", "fabric clock"}),
        "mclk_mhz": clock({"mclk", "memory clock"}),
        "uclk_mhz": clock({"uclk", "memory controller clock"}),
        "product_serial": read("/sys/class/dmi/id/product_serial"),
        "board_serial": read("/sys/class/dmi/id/board_serial"),
        "product_uuid": read("/sys/class/dmi/id/product_uuid"),
    }
    identity = cpu_identity()
    if result["cpu_multiplier"] is not None:
        result["multiplier_source"] = "IA32_PERF_STATUS · first readable CPU"
    adapters = (amd_multiplier(identity), ryzen_pm(identity) or amd_hsmp(identity), intel_memory(identity))
    for adapter in adapters:
        if result["cpu_voltage_v"] is not None:
            adapter.pop("voltage_source", None)
        for key, value in adapter.items():
            if key in {"fclk_mhz", "mclk_mhz", "uclk_mhz"} or result.get(key) is None:
                result[key] = value
    return result


def authorized(uid):
    if uid <= 0:
        return False
    try:
        secure_regular(f"{GRANTS}/{uid}")
        return True
    except (OSError, RuntimeError):
        return False


def denial(uid):
    try:
        with operation_lock(wait=False):
            # Absence is meaningful only while no install/enable can still commit.
            absent = not authorized(uid)
        return {"enabled": False, "revoked": absent, "error": "Hardware access is not authorized."}
    except Busy as error:
        return {"enabled": False, "busy": True, "revoked": False, "error": str(error)}
    except (OSError, RuntimeError) as error:
        return {"enabled": False, "revoked": False, "error": str(error)[:1024]}


def revoke(uid):
    try:
        with operation_lock(wait=False):
            try:
                os.unlink(f"{GRANTS}/{uid}")
            except FileNotFoundError:
                pass
        return {"enabled": False, "revoked": True}
    except Busy as error:
        return {"enabled": False, "busy": True, "revoked": False, "error": str(error)}
    except (OSError, RuntimeError) as error:
        return {"enabled": False, "revoked": False, "error": str(error)[:1024]}


def spd_eeproms():
    result = []
    for path in sorted(Path("/sys/bus/i2c/devices").glob("*-005[0-7]"))[:32]:
        try:
            driver = (path / "driver").resolve(strict=True).name
            if driver not in {"eeprom", "ee1004", "spd5118"}:
                continue
            with (path / "eeprom").open("rb") as stream:
                data = stream.read(1024)
            if len(data) >= 128:
                result.append({"source": path.name, "driver": driver, "hex": data.hex()})
        except OSError:
            continue
    return result


def serve():
    # Socket activation owns creation/permissions. Never unlink an arbitrary path.
    if os.environ.get("LISTEN_PID") != str(os.getpid()) or os.environ.get("LISTEN_FDS") != "1":
        raise RuntimeError("systemd socket activation is required")
    listener = socket.socket(fileno=3)
    while True:
        connection, _ = listener.accept()
        with connection:
            handle_connection(connection)


def handle_connection(connection, session_uid=None):
    connection.settimeout(2)
    try:
        _, uid, _ = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        allowed = uid == session_uid if session_uid is not None else authorized(uid)
        if not allowed:
            # Do not wait for bytes from an ungranted client on this serial server.
            result = denial(uid) if session_uid is None else {"enabled": False, "error": "Hardware access is not authorized."}
            connection.sendall(encoded_reply(result))
            # Discard only bytes already queued, without waiting on a denied client.
            # Otherwise a known client's unread frame can reset the reply on close.
            connection.setblocking(False)
            try:
                connection.recv(64, socket.MSG_DONTWAIT)
            except BlockingIOError:
                pass
            connection.shutdown(socket.SHUT_WR)
            return False
        request = connection.recv(64).strip()
        if session_uid is None and not authorized(uid):
            result = denial(uid)
        elif request == b"disable":
            result = revoke(uid) if session_uid is None else {"enabled": False}
        elif request == b"read":
            result = {"enabled": True, "data": snapshot()}
        elif request == b"spd":
            result = {"enabled": True, "spd": spd_eeproms()}
        else:
            result = {"enabled": False, "error": "Unknown hardware request."}
        connection.sendall(encoded_reply(result))
        return session_uid is not None and allowed and request == b"disable"
    except (OSError, ValueError):
        pass


def authenticated_uid():
    uid = int(os.environ["PKEXEC_UID"])
    if uid <= 0:
        raise RuntimeError("A non-root authenticated user is required")
    return uid


def session(pid, token, lifetime_fd=0):
    uid = authenticated_uid()
    if not token or len(token) != 32 or any(c not in "0123456789abcdef" for c in token):
        raise RuntimeError("Invalid session token")
    parent = os.pidfd_open(pid)
    try:
        if Path(f"/proc/{pid}").stat().st_uid != uid:
            raise RuntimeError("The parent process does not belong to the authenticated user")
        path = f"{SESSION_DIRECTORY}/taskmanager-hardware-{pid}-{token}.sock"
        with socket.socket(socket.AF_UNIX) as listener:
            listener.bind(path)
            try:
                # Only the authenticated account can connect; SO_PEERCRED is checked too.
                os.chown(path, uid, -1)
                os.chmod(path, 0o600)
                listener.listen(4)
                while True:
                    ready, _, _ = select.select([listener, parent, lifetime_fd], [], [], 1)
                    # Parent death or closing the launch pipe also covers crashes/auth races.
                    if parent in ready or (lifetime_fd in ready and not os.read(lifetime_fd, 1)):
                        break
                    if listener in ready:
                        connection, _ = listener.accept()
                        with connection:
                            if handle_connection(connection, uid):
                                break
            finally:
                os.unlink(path)
    finally:
        os.close(parent)


def unit_directories(lifetime):
    paths = run_fixed(["/usr/bin/systemd-analyze", "unit-paths"], lifetime).splitlines()
    if LOCAL_UNITS not in paths or any(not path.startswith("/") or ".." in Path(path).parts for path in paths):
        raise RuntimeError("The fixed local systemd unit directory is not supported")
    return paths


def bootstrap_payloads():
    if "INSTALL_SOURCE" not in globals():
        raise RuntimeError("Bootstrap payloads are available only in the embedded application helper")
    return [
        (LOCAL_HELPER, INSTALL_SOURCE, 0o755),
        (f"{LOCAL_UNITS}/taskmanager-hardware.service", SERVICE_TEXT.replace("/usr/libexec/taskmanager-hardware", LOCAL_HELPER), 0o644),
        (f"{LOCAL_UNITS}/taskmanager-hardware.socket", SOCKET_TEXT, 0o644),
        (POLICY, POLICY_TEXT.replace("/usr/libexec/taskmanager-hardware", LOCAL_HELPER), 0o644),
    ]


def check_bootstrap_layout(payloads, lifetime):
    paths = unit_directories(lifetime)
    # Any existing unit, mask, link or per-unit override can shadow the local assets.
    for directory in paths:
        for unit in ("taskmanager-hardware.service", "taskmanager-hardware.socket"):
            kind = unit.rsplit(".", 1)[1]
            for name in (unit, unit + ".d", f"taskmanager-.{kind}.d"):
                candidate = rooted(directory) / name
                if os.path.lexists(candidate):
                    raise RuntimeError(f"Existing hardware unit conflicts with bootstrap: {candidate}")
    for path, _, _ in payloads:
        if os.path.lexists(rooted(path)):
            raise RuntimeError(f"Existing hardware asset conflicts with bootstrap: {path}")
        secure_directory(rooted(path).parent, create=True)
    # A packaged helper must be enabled through its installed policy, never updated here.
    if os.path.lexists(rooted("/usr/libexec/taskmanager-hardware")):
        raise RuntimeError("A packaged hardware helper is already installed")


def publish_new(path, text, mode):
    directory = rooted(path).parent
    temporary = directory / f".taskmanager-install-{os.getpid()}"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        # link is atomic and fails for ANY existing destination (including symlinks).
        os.link(temporary, rooted(path), follow_symlinks=False)
    finally:
        temporary.unlink(missing_ok=True)


def verify_installed_layout(helper, lifetime):
    if helper not in ("/usr/libexec/taskmanager-hardware", LOCAL_HELPER):
        raise RuntimeError("Unsupported installed helper path")
    secure_directory(rooted(helper).parent)
    if not secure_regular(rooted(helper)).st_mode & 0o111:
        raise RuntimeError("The installed hardware helper is not executable")
    prefix = str(Path(helper).parent.parent)
    for name in ("taskmanager-hardware.service", "taskmanager-hardware.socket"):
        actual = run_fixed(["/usr/bin/systemctl", "show", "--property=FragmentPath", "--value", name], lifetime).strip()
        expected = f"{prefix}/lib/systemd/system/{name}"
        if actual != expected:
            raise RuntimeError("The hardware unit is shadowed or not discoverable")
        secure_directory(rooted(actual).parent)
        secure_regular(rooted(actual))
        if name.endswith(".service") and f"ExecStart={helper} serve" not in rooted(actual).read_text():
            raise RuntimeError("The hardware service does not use its installed helper")
    secure_directory(rooted(POLICY).parent)
    secure_regular(rooted(POLICY))
    action = ET.fromstring(rooted(POLICY).read_text()).find("action[@id='io.github.taskmanager.hardware.enable']")
    annotations = {} if action is None else {item.get("key"): item.text for item in action.findall("annotate")}
    if annotations.get("org.freedesktop.policykit.exec.path") != helper or annotations.get("org.freedesktop.policykit.exec.argv1") != "enable":
        raise RuntimeError("The hardware polkit action does not match the installed helper")
    actions = run_fixed(["/usr/bin/pkaction"], lifetime).splitlines()
    if "io.github.taskmanager.hardware.enable" not in actions:
        raise RuntimeError("The hardware polkit action is not discoverable")


def grant(uid, lifetime):
    run_fixed(["/usr/bin/systemctl", "enable", "--now", "taskmanager-hardware.socket"], lifetime)
    if lifetime is not None:
        lifetime.check()
    created = False
    try:
        fd = os.open(f"{GRANTS}/{uid}", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        os.close(fd)
        created = True
    except FileExistsError:
        secure_regular(f"{GRANTS}/{uid}")
    try:
        if lifetime is not None:
            lifetime.check()
    except BaseException:
        if created:
            os.unlink(f"{GRANTS}/{uid}")
        raise


def install_service(uid, lifetime):
    with operation_lock(lifetime):
        payloads = bootstrap_payloads()
        check_bootstrap_layout(payloads, lifetime)
        for path, text, mode in payloads:
            lifetime.check()
            publish_new(path, text, mode)
        run_fixed(["/usr/bin/systemctl", "daemon-reload"], lifetime)
        verify_installed_layout(LOCAL_HELPER, lifetime)
        grant(uid, lifetime)


def enable(uid, lifetime=None):
    with operation_lock(lifetime):
        verify_installed_layout(sys.argv[0], lifetime)
        grant(uid, lifetime)


def main():
    if os.geteuid() != 0:
        raise RuntimeError("This helper requires administrator authorization")
    if sys.argv[1:] == ["enable"]:
        # pkexec provides the authenticated caller. A command-line UID is never accepted.
        uid = authenticated_uid()
        # One explicit authorization also enables socket activation across logins/reboots.
        # No caller-controlled unit name, executable or arguments.
        enable(uid)
        sys.stdout.buffer.write(encoded_reply({"enabled": True}))
    elif len(sys.argv) == 3 and sys.argv[1] in ("install", "enable"):
        uid = authenticated_uid()
        lifetime = Lifetime(int(sys.argv[2]), uid)
        try:
            if sys.argv[1] == "install":
                install_service(uid, lifetime)
            else:
                enable(uid, lifetime)
            sys.stdout.buffer.write(encoded_reply({"enabled": True}))
        finally:
            lifetime.close()
    elif len(sys.argv) == 4 and sys.argv[1] == "session":
        session(int(sys.argv[2]), sys.argv[3])
    elif sys.argv[1:] == ["serve"]:
        serve()
    else:
        raise RuntimeError("Expected enable, install, session or serve")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError, KeyError, ET.ParseError) as error:
        # Failure never claims that a possibly preexisting persistent grant vanished.
        sys.stdout.buffer.write(encoded_reply({"enabled": False, "error": str(error)[:1024], **({"busy": True} if isinstance(error, Busy) else {})}))
        sys.exit(1)
